generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  password  String
  role      String   @default("mpme") // mpme | imf | admin
  fullName  String
  phone     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mpmeProfile MPMEProfile?
  imfProfile  IMFProfile?
}

model MPMEProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  company     String
  sector      String
  location    String   @default("Cotonou, Bénin")
  employees   Int      @default(1)
  createdYear Int
  ifuStatus   String   @default("Non démarré") // Non démarré | En cours | Complet
  rccmStatus  String   @default("Non démarré")
  npiStatus   String   @default("Non démarré")

  ivrPhone    String?  // numéro de l'employeur pour l'appel vocal automatique
  ivrTime     String   @default("18:00") // heure d'appel HH:MM

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  scores       Score[]
  ivrSessions  IVRSession[]
}

model Transaction {
  id          String   @id @default(uuid())
  mpmeId      String
  mpme        MPMEProfile @relation(fields: [mpmeId], references: [id], onDelete: Cascade)

  type        String   // entree | sortie
  amount      Float
  category    String   @default("autre") // vente | achat | depense | stock | autre
  description String?
  source      String   @default("manuel") // manuel | mobile_money
  date        DateTime @default(now())

  createdAt   DateTime @default(now())

  @@index([mpmeId, date])
}

model Score {
  id              String   @id @default(uuid())
  mpmeId          String
  mpme            MPMEProfile @relation(fields: [mpmeId], references: [id], onDelete: Cascade)

  total           Float
  mobileMoney     Float
  comptabilite    Float
  formalisation   Float
  profilSectoriel Float
  recommendation  String?

  calculatedAt    DateTime @default(now())

  @@index([mpmeId, calculatedAt])
}

model FinancingOffer {
  id          String   @id @default(uuid())
  name        String
  provider    String
  logo        String   @default("?")
  subtitle    String
  minScore    Float    @default(0)
  maxAmount   Float
  rate        Float?
  duration    String?
  offerType   String   @default("credit") // credit | subvention | appel_projets
  sector      String?  // null = tous secteurs
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
}

model IMFProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  institution String
  createdAt   DateTime @default(now())
}

model SectorSheet {
  id           String   @id @default(uuid())
  sector       String   @unique
  title        String
  actors       String   // JSON : [{ role, description }]
  marketPrices String   // JSON : [{ item, price, unit }]
  trends       String
  regulation   String
  tips         String   // JSON : string[]
  audioFile    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model IVRSession {
  id          String   @id @default(uuid())
  token       String   @unique @default(uuid())
  mpmeId      String
  mpme        MPMEProfile @relation(fields: [mpmeId], references: [id], onDelete: Cascade)

  status      String   @default("pending") // pending | active | completed | expired
  step        String   @default("ventes")  // ventes | depenses | done

  venteAmount   Float?
  depenseAmount Float?
  venteText     String?
  depenseText   String?

  createdAt   DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@index([token])
  @@index([mpmeId, createdAt])
}

model SectorNews {
  id          String   @id @default(uuid())
  sector      String?  // null = toutes secteurs
  title       String
  body        String
  type        String   @default("info") // info | alerte | opportunite
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([sector, publishedAt])
}
